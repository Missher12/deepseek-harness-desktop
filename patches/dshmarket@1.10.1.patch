+/**
+ * Snapshot every profile-manifest field mutated by plugin installation.
+ * A bundle carrier can be written to dsh.profile.bundles independently from
+ * its top-level dependency, so rolling back only dependencies is not a
+ * transaction and can brick the next loader boot.
+ */
+export function readProfileManifestSnapshot(profile, explicitDir) {
+    const directory = profileDir(profile, explicitDir);
+    try {
+        const manifest = JSON.parse(readFileSync(join(directory, 'package.json'), 'utf8'));
+        const bundles = manifest.dsh?.profile?.bundles;
+        return {
+            dependencies: { ...manifest.dependencies },
+            bundles: Array.isArray(bundles) ? bundles.filter((name) => typeof name === 'string') : [],
+        };
+    }
+    catch {
+        return { dependencies: {}, bundles: [] };
+    }
+}
+/** Restore dependencies and the profile bundle list as one failed-operation rollback. */
+export function restoreProfileManifestSnapshot(profile, snapshot, explicitDir) {
+    const file = join(profileDir(profile, explicitDir), 'package.json');
+    let manifest;
+    try {
+        manifest = JSON.parse(readFileSync(file, 'utf8'));
+    }
+    catch {
+        return [];
+    }
+    const currentDependencies = manifest.dependencies ?? {};
+    const currentBundles = Array.isArray(manifest.dsh?.profile?.bundles) ? manifest.dsh.profile.bundles : [];
+    const touched = new Set();
+    for (const name of Object.keys(currentDependencies)) {
+        if (currentDependencies[name] !== snapshot.dependencies[name])
+            touched.add(name);
+    }
+    for (const name of Object.keys(snapshot.dependencies)) {
+        if (currentDependencies[name] !== snapshot.dependencies[name])
+            touched.add(name);
+    }
+    const currentBundleSet = new Set(currentBundles);
+    const snapshotBundleSet = new Set(snapshot.bundles);
+    for (const name of currentBundles)
+        if (!snapshotBundleSet.has(name))
+            touched.add(name);
+    for (const name of snapshot.bundles)
+        if (!currentBundleSet.has(name))
+            touched.add(name);
+    if (touched.size === 0)
+        return [];
+    manifest.dependencies = { ...snapshot.dependencies };
+    manifest.dsh ??= {};
+    manifest.dsh.profile ??= {};
+    manifest.dsh.profile.bundles = [...snapshot.bundles];
+    writeFileSync(file, `${JSON.stringify(manifest, null, 2)}\n`);
+    return [...touched].sort();
