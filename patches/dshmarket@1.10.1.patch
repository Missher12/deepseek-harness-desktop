   void Promise.resolve(navigator.clipboard?.writeText(p.name)).catch(() => {})\n                    }\n                  }}\n                  align=\"end\"\n                  portal\n                  anchor={(\n                    <Button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      className={css.overflowButton}\n                      aria-label={`${t('moreActions')}: ${p.name}`}\n                      icon={<IconEllipsisOutline16 size={16} />}\n                      onClick={() => setRowMenuUrl(rowMenuUrl === p.url ? null : p.url)}\n                    />\n                  )}\n                  items={[\n                    { id: 'manage', label: t('managePlugin') },\n                    { id: 'source', label: t('viewSource') },\n                    { id: 'copy-package', label: t('copyPackage') },\n                  ]}\n                />\n              </span>\n            )\n          : (\n              <div className={css.pluginAction} data-dshmarket-primary-action>\n                {busy\n                  ? <Button variant=\"outline\" size=\"sm\" className={css.primaryAction} disabled>{t('installing')}</Button>\n                  : (\n                      <Button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        className={css.primaryAction}\n                        disabled={busyUrl !== null || !envReady}\n                        onClick={() => setConfirming(p)}\n                      >{t('install')}</Button>\n                    )}\n              </div>\n            )}\n        {busy && (\n          <div className={`${css.progress} ${css.pluginProgress}`}>\n            <span className={css.spin}><IconLoadingOutline16 size={14} /></span>\n            <code className={css.grow}>{progressText}</code>\n            {progressPct !== null && <span className={css.pct}>{progressPct}%</span>}\n            <Button variant=\"outline\" size=\"sm\" disabled