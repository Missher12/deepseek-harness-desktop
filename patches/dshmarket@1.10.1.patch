+ * deliberately ambiguous.
+ */
+export function classifyBundleResidue(profileDirectory) {
+    let dependencies = {};
+    try {
+        const manifest = JSON.parse(readFileSync(join(profileDirectory, 'package.json'), 'utf8'));
+        dependencies = manifest.dependencies ?? {};
