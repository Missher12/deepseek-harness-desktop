{
  "name": "@deepseek-ai/dsh-desktop-managed-memory",
  "description": "Desktop-owned dual-face entrypoint for Missher project memory",
  "version": "0.5.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Missher12/deepseek-harness-desktop.git",
    "directory": "apps/desktop-managed-memory"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
